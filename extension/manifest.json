{
  "manifest_version": 3,
  "name": "Cru Instagram Review Helper",
  "version": "1.0.0",
  "description": "Lets the Cru Mission Expansion app move one Instagram tab to the next handle. Never reads or changes Instagram page content.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*"
    ]
  }
}